---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import Category from "@/components/Category.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import { UNCATEGORIZED } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// 하단 스펙 줄에 쓰는 실제 수치. 글이 늘면 저절로 따라 바뀐다.
const postDates = sortedPosts
  .map(post => post.data.pubDatetime)
  .sort((a, b) => a.getTime() - b.getTime());
const yearMonth = (date: Date | undefined) =>
  date
    ? `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}`
    : "";
const postSpan =
  postDates.length > 0
    ? `${yearMonth(postDates[0])}–${yearMonth(postDates.at(-1))}`
    : "";

// 홈 미리보기를 최신순으로만 뽑으면 같은 시기에 몰아 쓴 글만 나열된다.
// 분류가 겹치지 않게 먼저 훑어 무엇을 적는 곳인지가 한눈에 보이게 한다.
const peek: typeof recentPosts = [];
const seenTopics = new Set<string>();
for (const post of recentPosts) {
  const topic = post.data.category ?? UNCATEGORIZED;
  if (seenTopics.has(topic)) {
    continue;
  }
  seenTopics.add(topic);
  peek.push(post);
  if (peek.length >= postsConfig.perIndex) {
    break;
  }
}
// 주제가 모자라면 최신순으로 채운다.
for (const post of recentPosts) {
  if (peek.length >= postsConfig.perIndex) {
    break;
  }
  if (!peek.includes(post)) {
    peek.push(post);
  }
}

/*
 * 무엇을 적는 곳인지는 글에서 뽑는다 — 여기에 손으로 적으면 글이 늘 때마다 어긋난다.
 * 아직 글이 없는 분류는 나오지 않는다(빈 분류를 광고하지 않기 위해).
 */
const topics = getUniqueCategories(posts);
const listUrl = getRelativeLocaleUrl(locale, "posts/");
---

<Layout>
  <Header />

  {/* 섹션마다 배경을 갈아 끼우려고 main 에서 폭 제한을 걷어낸다. */}
  <main id="main-content" data-layout="index" data-home-path={homePath}>
    {/* 첫 화면의 할 일은 글로 보내는 것 하나 — 배너 높이를 넘기지 않는다. */}
    <section class="px-4 py-10 text-center sm:py-14">
      {
        /*
        제목이 스스로 태도를 보여주게 한다 — 상황이 뒤로 물러나고 태도가 앞으로 나온다.
        화면 낭독기에는 여전히 "문제를 불편한 채로 두기보다 해결하려고 합니다" 한 문장이다.
      */
      }
      <h1 class="mx-auto max-w-4xl font-semibold">
        <span
          class="text-muted-foreground block text-[clamp(1rem,2.2vw,1.375rem)]"
        >
          문제를 불편한 채로 두기보다
        </span>
        <span class="mt-1 block text-[clamp(2rem,5vw,3.25rem)]">
          해결하려고 합니다
        </span>
      </h1>
      <p
        class="text-muted-foreground mx-auto mt-4 max-w-2xl text-base leading-relaxed sm:text-lg"
      >
        AI 에이전트를 만들며 부딪힌 것과, 그러다 다시 들여다본 웹·백엔드
        기본기를 적습니다.
      </p>
      {
        topics.length > 0 && (
          <ul class="mt-6 flex flex-wrap justify-center gap-2">
            {topics.map(category => (
              <Category {category} size="sm" />
            ))}
          </ul>
        )
      }
    </section>

    {/* 배경은 바탕색 그대로 두고, 카드만 흰 면으로 띄워 층을 만든다. */}
    <section class="border-border border-y px-4 py-12 sm:py-16">
      <div class="app-layout">
        {
          featuredPosts.length > 0 && (
            <div class="mb-16">
              <h2 class="text-center text-[clamp(1.75rem,4vw,2.75rem)] font-semibold">
                {t.home.featured}
              </h2>
              <ul
                class:list={[
                  "mt-8 grid gap-6",
                  featuredPosts.length > 1 && "sm:grid-cols-2",
                ]}
              >
                {featuredPosts.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </div>
          )
        }

        {
          recentPosts.length > 0 && (
            <div>
              <h2 class="text-center text-[clamp(1.75rem,4vw,2.75rem)] font-semibold">
                지금까지 쓴 글
              </h2>
              <ul
                class:list={[
                  "mt-8 grid gap-6",
                  peek.length > 1 && "sm:grid-cols-2",
                ]}
              >
                {peek.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </div>
          )
        }

        <p class="mt-10 text-center text-lg">
          <a class="link-arrow" href={listUrl}>
            {t.home.allPosts}
          </a>
        </p>
      </div>
    </section>

    {
      /*
      홈을 닫는 줄. 무엇을 적는 곳인지는 위에서 이미 말했으므로 여기서는
      나가는 문(연락처·구독)과 규모만 둔다.
    */
    }
    <section class="border-border border-t px-4 py-12 text-center sm:py-16">
      {
        socials.length > 0 && (
          <div class="flex items-center justify-center gap-4">
            <Socials />
          </div>
        )
      }

      {
        /* 아직 0 인 값을 첫 방문자에게 굳이 세어 보일 필요는 없다. 생기면 저절로 나온다. */
      }
      <p class="app-meta text-muted-foreground mt-6 text-xs">
        {sortedPosts.length > 0 && `글 ${sortedPosts.length} · `}
        {postSpan && `${postSpan} · `}
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="hover:text-foreground">RSS</a
        >
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* 애플이 링크에 붙이는 겹화살괄호. 텍스트 옆에 붙어 따라다닌다. */
  .link-arrow {
    color: var(--accent);
  }
  .link-arrow::after {
    content: " \203A";
    display: inline-block;
    margin-inline-start: 0.15em;
  }
  .link-arrow:hover {
    text-decoration: underline;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
