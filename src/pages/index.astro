---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { excludeArchived, isArchived, topicTags } from "@/utils/archiveFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const allSorted = getSortedPosts(posts);
const sortedPosts = excludeArchived(allSorted);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const archivedPosts = allSorted.filter(isArchived);
const homePath = getRelativeLocaleUrl(locale, "");

// 하단 스펙 줄에 쓰는 실제 수치. 글이 늘면 저절로 따라 바뀐다.
const archiveDates = archivedPosts
  .map(post => post.data.pubDatetime)
  .sort((a, b) => a.getTime() - b.getTime());
const yearMonth = (date: Date | undefined) =>
  date
    ? `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}`
    : "";
const archiveSpan =
  archiveDates.length > 0
    ? `${yearMonth(archiveDates[0])}–${yearMonth(archiveDates.at(-1))}`
    : "";

// 지난 기록 미리보기는 최신순으로 뽑으면 같은 시기에 몰아 쓴 알고리즘 풀이만 나열된다.
// 주제(태그)가 겹치지 않게 골라 무엇을 공부했는지가 한눈에 보이게 한다.
const topicOf = (tags: string[]) => topicTags(tags)[0] ?? "etc";

const archivePeek: typeof archivedPosts = [];
const seenTopics = new Set<string>();
for (const post of archivedPosts) {
  const topic = topicOf(post.data.tags);
  if (seenTopics.has(topic)) continue;
  seenTopics.add(topic);
  archivePeek.push(post);
  if (archivePeek.length >= postsConfig.perIndex) break;
}

const archivesUrl = getRelativeLocaleUrl(locale, "archives/");

/*
 * 첫 화면에서 이 블로그가 무엇을 적는 곳인지 설명 대신 실물로 보여주는 보기.
 * 위가 눈에 보이던 증상, 아래가 실제로 고쳐야 했던 자리다. 전부 겪은 것들.
 */
const traces = [
  {
    symptom: "목록 개수가 실제 데이터와 안 맞는다",
    cause: "조건 하나를 세 군데에서 서로 다르게 세고 있었다",
  },
  {
    symptom: "새벽에 서비스가 멈췄다",
    cause: "1년에 한 번인 인증서 갱신을 잊었다",
  },
  {
    symptom: "연동한 API가 조용히 빈 값을 준다",
    cause: "남이 준 응답을 그대로 믿고 있었다",
  },
];
const listUrl = getRelativeLocaleUrl(
  locale,
  recentPosts.length === 0 ? "archives/" : "posts/"
);
---

<Layout>
  <Header />

  {/* 섹션마다 배경을 갈아 끼우려고 main 에서 폭 제한을 걷어낸다. */}
  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <section class="px-4 py-12 text-center sm:py-16">
      {
        /*
        제목이 스스로 주제를 보여주게 한다 — 증상은 뒤로 물러나고 원인이 앞으로 나온다.
        화면 낭독기에는 여전히 "증상 말고 원인을 고칩니다" 한 문장이다.
      */
      }
      <h1 class="mx-auto max-w-4xl font-semibold">
        <span
          class="text-muted-foreground block text-[clamp(1.25rem,3vw,2rem)]"
        >
          증상 말고
        </span>
        <span class="mt-1 block text-[clamp(2.5rem,7vw,4.5rem)]">
          원인을 고칩니다
        </span>
      </h1>
      <p
        class="text-muted-foreground mx-auto mt-6 max-w-2xl text-[clamp(1.125rem,2.4vw,1.5rem)] leading-snug"
      >
        백엔드 개발자 이준석입니다. 급하게 막아둔 건 꼭 다시 터지더라고요.
        무엇이 왜 고장났고 어떻게 고쳤는지를 적습니다.
      </p>

      {
        /*
        제목이 말한 것을 화면에서 한 번 더 보여준다 — 위가 증상, 아래가 원인.
        가운데로 모인 문단 사이에서 유일하게 왼쪽으로 정렬해 눈이 여기서 멈추게 한다.

        고정폭 서체는 쓰지 않는다 — 한글은 낱자 폭이 라틴 글자에 맞춰 늘어나서
        글자 사이가 성기게 벌어진다. 기록처럼 보이는 인상은 └ 기호와 두 줄 구조가 낸다.
      */
      }
      <ul
        class="mx-auto mt-10 grid max-w-lg gap-5 text-start text-[15px] sm:text-base"
      >
        {
          traces.map(({ symptom, cause }) => (
            <li>
              <p class="text-muted-foreground">{symptom}</p>
              <p class="mt-1 flex gap-2">
                <span class="text-accent select-none" aria-hidden="true">
                  └
                </span>
                <span>{cause}</span>
              </p>
            </li>
          ))
        }
      </ul>

      {
        /* 소개는 위 메뉴에 이미 있다 — 첫 화면의 할 일은 글로 보내는 것 하나다. */
      }
      <p class="mt-10 text-lg">
        <a class="link-arrow" href={archivesUrl}>지난 글 보기</a>
      </p>
    </section>

    {/* 배경은 바탕색 그대로 두고, 카드만 흰 면으로 띄워 층을 만든다. */}
    <section class="border-border border-y px-4 py-16 sm:py-20">
      <div class="app-layout">
        {
          featuredPosts.length > 0 && (
            <div class="mb-16">
              <h2 class="text-center text-[clamp(1.75rem,4vw,2.75rem)] font-semibold">
                {t.home.featured}
              </h2>
              <ul class="mt-10 grid gap-6 sm:grid-cols-2">
                {featuredPosts.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </div>
          )
        }

        {
          recentPosts.length > 0 && (
            <div>
              <h2 class="text-center text-[clamp(1.75rem,4vw,2.75rem)] font-semibold">
                {t.home.recentPosts}
              </h2>
              <ul class="mt-10 grid gap-6 sm:grid-cols-2">
                {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </div>
          )
        }

        {
          /* 새 글이 아직 없을 때는 이 자리가 통째로 비므로, 지난 기록을 대신 보여준다. */
          recentPosts.length === 0 && archivedPosts.length > 0 && (
            <div>
              <h2 class="text-center text-[clamp(1.75rem,4vw,2.75rem)] font-semibold">
                그동안 남긴 기록
              </h2>
              <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-center text-lg sm:text-xl">
                2018~2022년, 처음 서버와 알고리즘을 배우면서 남긴{" "}
                {archivedPosts.length}편입니다. 새 글은 여기에 이어서 올려요.
              </p>
              <ul class="mt-10 grid gap-6 sm:grid-cols-2">
                {archivePeek.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </div>
          )
        }

        <p class="mt-10 text-center text-lg">
          <a class="link-arrow" href={listUrl}>
            {recentPosts.length === 0 ? "지난 글 전체 보기" : t.home.allPosts}
          </a>
        </p>
      </div>
    </section>

    <section class="px-4 py-20 text-center sm:py-24">
      <h2 class="text-[clamp(1.5rem,3.4vw,2.25rem)] font-semibold">
        요즘은 제 일을 대신할 것들을 만듭니다
      </h2>
      <p
        class="text-muted-foreground mx-auto mt-4 max-w-2xl text-lg sm:text-xl"
      >
        코드 리뷰도, 하루 회고도 Slack에서 부르면 에이전트가 대신합니다. 그렇게
        하나씩 떠넘기는 중이에요. 잘 된 것보다{" "}
        <span class="text-foreground">틀렸다가 알아낸 것</span>이 더 많습니다.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-8 flex items-center justify-center gap-4">
            <Socials />
          </div>
        )
      }

      {
        /* 아직 0 인 값을 첫 방문자에게 굳이 세어 보일 필요는 없다. 생기면 저절로 나온다. */
      }
      <p class="app-meta text-muted-foreground mt-10 text-xs">
        {sortedPosts.length > 0 && `글 ${sortedPosts.length} · `}
        지난 기록 {archivedPosts.length}
        {archiveSpan && ` · ${archiveSpan}`} ·{" "}
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="hover:text-foreground">RSS</a
        >
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* 애플이 링크에 붙이는 겹화살괄호. 텍스트 옆에 붙어 따라다닌다. */
  .link-arrow {
    color: var(--accent);
  }
  .link-arrow::after {
    content: " \203A";
    display: inline-block;
    margin-inline-start: 0.15em;
  }
  .link-arrow:hover {
    text-decoration: underline;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
