---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import {
  excludeArchived,
  isArchived,
  topicTags,
} from "@/utils/archiveFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const allSorted = getSortedPosts(posts);
const sortedPosts = excludeArchived(allSorted);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const archivedPosts = allSorted.filter(isArchived);
const homePath = getRelativeLocaleUrl(locale, "");

// 첫 화면 상태 줄에 쓰는 실제 수치. 글이 늘면 저절로 따라 바뀐다.
const archiveDates = archivedPosts
  .map(post => post.data.pubDatetime)
  .sort((a, b) => a.getTime() - b.getTime());
const yearMonth = (date: Date | undefined) =>
  date
    ? `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}`
    : "";
const archiveSpan =
  archiveDates.length > 0
    ? `${yearMonth(archiveDates[0])}–${yearMonth(archiveDates.at(-1))}`
    : "";

// 지난 기록 미리보기는 최신순으로 뽑으면 같은 시기에 몰아 쓴 알고리즘 풀이만 나열된다.
// 주제(태그)가 겹치지 않게 골라 무엇을 공부했는지가 한눈에 보이게 한다.
const topicOf = (tags: string[]) => topicTags(tags)[0] ?? "etc";

const archivePeek: typeof archivedPosts = [];
const seenTopics = new Set<string>();
for (const post of archivedPosts) {
  const topic = topicOf(post.data.tags);
  if (seenTopics.has(topic)) continue;
  seenTopics.add(topic);
  archivePeek.push(post);
  if (archivePeek.length >= postsConfig.perIndex) break;
}

---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="pt-16 pb-14 sm:pt-24 sm:pb-20">
      <h1 class="text-[2.6rem] font-semibold sm:text-6xl">
        서버 만들고,<br />AI한테 제 일 시킵니다
      </h1>

      <p class="text-muted-foreground mt-6 max-w-2xl text-lg sm:text-xl">
        백엔드 개발자 이준석입니다. NestJS와 TypeScript로 서버를 만들고, 요즘은
        Slack에서 부르면 리뷰하고 회고하고 코드까지 짜는 에이전트들을 만들어 두고
        일을 떠넘기는 중입니다.
      </p>
      <p class="text-muted-foreground mt-4 max-w-2xl text-lg sm:text-xl">
        여기에는 만들면서 알게 된 것들을 적습니다. 잘 된 것보다 <span
          class="text-foreground">틀렸다가 알아낸 것</span
        >이 더 많을 예정입니다.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-8 flex items-center gap-3">
            <Socials />
          </div>
        )
      }

      <!-- 제품 스펙처럼 아래에 조용히. 수치는 글이 늘면 따라 바뀐다. -->
      <p class="app-meta text-muted-foreground mt-10 text-xs">
        글 {sortedPosts.length} · 지난 기록 {archivedPosts.length}
        {archiveSpan && ` · ${archiveSpan}`} ·{" "}
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="hover:text-foreground">RSS</a
        >
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-14 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-3xl font-semibold">{t.home.featured}</h2>
          <ul class="mt-8 space-y-3">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="border-border border-t pt-14 pb-6">
          <h2 class="text-3xl font-semibold">{t.home.recentPosts}</h2>
          <ul class="mt-8 space-y-3">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      /* 새 글이 아직 없을 때는 첫 화면이 통째로 비므로, 지난 기록을 대신 보여준다. */
      recentPosts.length === 0 && archivedPosts.length > 0 && (
        <section id="archive-peek" class="border-border border-t pt-14 pb-6">
          <h2 class="text-3xl font-semibold">그동안 남긴 기록</h2>
          <p class="text-muted-foreground mt-3 max-w-2xl text-lg">
            새 글은 준비 중입니다. 그 사이 2018~2022년에 공부하며 적어둔 것들을
            놓아둡니다.
          </p>
          <ul class="mt-8 space-y-3">
            {archivePeek.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-10 mb-4 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(
          locale,
          recentPosts.length === 0 ? "archives" : "posts"
        )}
      >
        {recentPosts.length === 0 ? "지난 글 전체 보기" : t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

