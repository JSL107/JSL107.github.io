---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { topicTags } from "@/utils/archiveFilter";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const {
  title,
  description,
  tags,
  pubDatetime,
  modDatetime,
  timezone: postTimezone,
} = data;

// 목록에서는 글 주제만 보여준다. archive/summary 는 모든 옛 글에 붙어 있어 구분에 도움이 안 된다.
const visibleTags = topicTags(tags).slice(0, 3);

const date = dayjs(modDatetime ?? pubDatetime)
  .tz(postTimezone ?? config.site.timezone)
  .format("YYYY.MM.DD");
---

<li>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="group bg-background focus-visible:outline-accent block h-full rounded-2xl px-6 py-5 focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    <p class="app-meta text-muted-foreground text-xs">
      <time datetime={pubDatetime.toISOString()}>{date}</time>
      {
        visibleTags.length > 0 && (
          <span>
            {" · "}
            {visibleTags.join(" · ")}
          </span>
        )
      }
    </p>

    <Heading
      transition:name={toTransitionName(id)}
      class="group-hover:text-accent mt-1.5 text-xl font-semibold"
    >
      {title}
    </Heading>

    {
      description && (
        <p class="text-muted-foreground mt-2 line-clamp-2">{description}</p>
      )
    }
  </a>
</li>
