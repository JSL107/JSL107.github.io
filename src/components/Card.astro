---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { categoryName } from "@/utils/categories";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const {
  title,
  description,
  category,
  pubDatetime,
  modDatetime,
  timezone: postTimezone,
} = data;

// 옛 글에는 분류가 없다(목록에서 빼둔 글이라 붙이지 않았다) — 그때는 날짜만 보인다.
const label = category ? categoryName(category) : "";

const date = dayjs(modDatetime ?? pubDatetime)
  .tz(postTimezone ?? config.site.timezone)
  .format("YYYY.MM.DD");
---

{
  /* 이 카드를 담는 목록에는 모서리 반경(rounded-2xl = 16px)보다 큰 gap 을 줄 것.
     반경과 같은 16px 을 주면 좌우 끝에서 위아래 곡선이 정확히 마주 붙어 오목한
     목이 생기고, 그림자까지 겹쳐 배경 띠가 14px 로 좁아져 여전히 물려 보인다. */
}
<li>
  {
    /*
     * 밝은 화면에서 바탕(#f5f5f7)과 카드(#fff)의 밝기 차이는 거의 없다. 색만으로는
     * 카드가 떠 보이지 않으므로 옅은 그림자로 층을 만든다. 어두운 화면은 바탕이
     * 순검정이라 색 차이만으로 이미 구분되고, 검정 위 검은 그림자는 보이지도 않는다.
     */
  }
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="group bg-surface focus-visible:outline-accent block h-full rounded-2xl px-6 py-5 shadow-sm transition-shadow hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 dark:shadow-none"
  >
    {
      /* 고정폭은 기계가 찍은 날짜에만. 태그는 사람이 붙인 분류라 본문 서체로 둔다. */
    }
    <p class="text-muted-foreground text-xs">
      <time class="app-meta" datetime={pubDatetime.toISOString()}>
        {date}
      </time>
      {label && <span>{` · ${label}`}</span>}
    </p>

    <Heading
      transition:name={toTransitionName(id)}
      class="group-hover:text-accent mt-1.5 text-xl font-semibold"
    >
      {title}
    </Heading>

    {
      description && (
        <p class="text-muted-foreground mt-2 line-clamp-2">{description}</p>
      )
    }
  </a>
</li>
