---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  /** 목록이 아니라 처음부터 끝까지 읽는 화면일 때. 한 줄이 짧아진다. */
  narrow?: boolean;
  class?: string;
};

const { pageTitle, pageDesc, narrow = false, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={[narrow ? "app-read pb-4" : "app-layout pb-4", className]}
>
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{pageTitle}</h1>
  <p class="text-muted-foreground mt-2 mb-6 max-w-prose">{pageDesc}</p>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
