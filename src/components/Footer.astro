---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

// 맨 아래까지 내려온 사람이 다음에 갈 곳이 없으면 그대로 이탈한다.
const links = [
  { label: t.nav.posts, href: getRelativeLocaleUrl(locale, "posts/") },
  { label: t.nav.archives, href: getRelativeLocaleUrl(locale, "archives/") },
  {
    label: t.nav.categories,
    href: getRelativeLocaleUrl(locale, "categories/"),
  },
  { label: t.nav.about, href: getRelativeLocaleUrl(locale, "about/") },
  {
    label: "RSS",
    href: `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`,
  },
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border border-t pt-6 pb-8">
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <nav aria-label="사이트 링크">
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          {
            links.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="hover:text-accent focus-visible:outline-accent transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <Socials />
    </div>

    <p class="app-meta text-muted-foreground mt-6 text-xs">
      {t.footer.copyright} &#169; {currentYear} · {t.footer.allRightsReserved}
    </p>
  </div>
</footer>
