---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "border-border hover:border-accent/60 hover:text-accent focus-visible:outline-accent inline-flex items-baseline gap-1 rounded-full border transition-colors focus-visible:outline-2 focus-visible:outline-offset-2",
      { "px-2.5 py-0.5 text-sm": size === "sm" },
      { "px-3 py-1 text-base": size === "lg" },
    ]}
  >
    <span class="text-muted-foreground" aria-hidden="true">#</span>
    {tagName}
  </a>
</li>
